# ── Database: Postgres via PgBouncer ──────────────────────────────
# DATABASE_URL = pooled connection through PgBouncer (transaction pooling).
#   Prepared statements don't survive transaction pooling, so disable them.
# DIRECT_URL   = direct connection to Postgres, used ONLY for prisma migrate / db push.
DATABASE_URL="postgresql://user:password@pgbouncer-host:6432/hotelvideo?pgbouncer=true&connection_limit=1&prepared_statements=false"
DIRECT_URL="postgresql://user:password@postgres-host:5432/hotelvideo?sslmode=require"

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────
AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# ── Stream.io Video ───────────────────────────────────────────────
STREAM_API_KEY="your-stream-api-key"
STREAM_SECRET="your-stream-api-secret"            # NEVER commit the real value
NEXT_PUBLIC_STREAM_API_KEY="your-stream-api-key"
STREAM_WEBHOOK_SECRET="your-stream-webhook-secret" # verifies Stream transcription/recording webhooks

# ── OpenRouter (LLM step: transcript → summary / service-request JSON) ──
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# ── Hotel CRM webhook (your other hotel repo) ─────────────────────
# Inbound endpoint we POST service-requests / profile-updates to.
HOTEL_CRM_WEBHOOK_URL="https://hotel-app.example.com/api/concierge/webhook"
HOTEL_CRM_WEBHOOK_SECRET="shared-hmac-secret"

# ── Bunny CDN (recording storage) ─────────────────────────────────
BUNNY_ACCESS_KEY="your-bunny-access-key"
BUNNY_STORAGE_ZONE="your-storage-zone"
BUNNY_CDN_URL="https://cdn.bunny.net"
BUNNY_STORAGE_URL="https://storage.bunnycdn.com"

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY="your-resend-api-key"
SMTP_FROM="concierge@yourhotel.com"

# ── App ───────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
