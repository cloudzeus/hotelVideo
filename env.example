# ── Required (bootstrap: can't live in the DB) ────────────────────
# Postgres via PgBouncer. DATABASE_URL = pooled (runtime), DIRECT_URL = direct (migrate).
DATABASE_URL="postgresql://user:password@pgbouncer-host:6432/hotelvideo?pgbouncer=true&connection_limit=1&prepared_statements=false"
DIRECT_URL="postgresql://user:password@postgres-host:5432/hotelvideo?sslmode=require"

AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stream public API key — baked into the client bundle at build time, so it MUST be env.
NEXT_PUBLIC_STREAM_API_KEY="your-stream-public-key"

# Verifies inbound Stream webhooks (recording/transcription events).
STREAM_WEBHOOK_SECRET="your-stream-webhook-secret"

# ── Hotel CRM webhook (concierge → ephyria-web) ───────────────────
HOTEL_CRM_WEBHOOK_URL="https://ephyria.gr/api/concierge/webhook"
HOTEL_CRM_WEBHOOK_SECRET="shared-hmac-secret"   # must match ephyria-web's CONCIERGE_WEBHOOK_SECRET

# ── Managed in the app: Settings → Integrations (stored in the DB) ──
# These are OPTIONAL here and only used as a fallback before anything is saved
# in Settings → Integrations. Leave them out in production.
#   Stream:     STREAM_API_KEY, STREAM_SECRET
#   Bunny CDN:  BUNNY_ACCESS_KEY, BUNNY_STORAGE_ZONE, BUNNY_CDN_URL, BUNNY_STORAGE_URL
#   OpenRouter: OPENROUTER_API_KEY, OPENROUTER_MODEL
#   Mailgun:    MAILGUN_API_KEY, MAILGUN_DOMAIN, MAILGUN_FROM, MAILGUN_REGION
#   Resend (email fallback): RESEND_API_KEY

NODE_ENV="production"
